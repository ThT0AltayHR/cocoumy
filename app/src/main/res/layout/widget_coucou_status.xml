<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_jarvis_dock"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HELLOAI"
        android:textColor="#F4F6FF"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Hazır · Sohbeti aç"
        android:textColor="#C6D0E5"
        android:textSize="12sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widgetWeather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Hava durumu için konum izni ver"
        android:textColor="#9FE7B8"
        android:textSize="11sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widgetOpenChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="Sohbete dön  ›"
        android:textColor="#0C1420"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="#DAE4F9" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Geri" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sistem izinleri"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İzinler ve gizlilik denetimi"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_jarvis_card"
                android:padding="22dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_jarvis_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Coucou AI logosu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Coucou AI • Akıllı asistan"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Coucou AI’nin konuşabilmesi, hava durumunu sunabilmesi ve isteklerini işleyebilmesi için gereken izinleri ver."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Card 1: Microphone -->
            <LinearLayout
                android:id="@+id/cardMicPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_avatar"
                        android:padding="8dp"
                        android:src="@drawable/ic_mic_jarvis"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mikrofon erişimi"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontrol ediliyor…"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantMic"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin ver"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sesli sohbet, konuşma tanıma ve gerçek zamanlı ses etkileşimi için gereklidir."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 2: Location -->
            <LinearLayout
                android:id="@+id/cardLocationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_avatar"
                        android:padding="8dp"
                        android:src="@drawable/ic_weather_sun"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kesin konum"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontrol ediliyor…"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin ver"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ana ekranda bulunduğun konuma göre hava durumu ve sıcaklık bilgisini göstermek için gereklidir."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 3: Notification -->
            <LinearLayout
                android:id="@+id/cardNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_avatar"
                        android:padding="8dp"
                        android:src="@drawable/ic_nav_bell"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bildirimler"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusNotification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontrol ediliyor…"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin ver"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Hatırlatıcılar ve arka plan ses hizmetinin durum bildirimleri için gereklidir."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 4: System Overlay -->
            <LinearLayout
                android:id="@+id/cardOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_avatar"
                        android:padding="8dp"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diğer uygulamaların üzerinde göster"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontrol ediliyor…"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin ver"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="İsteğe bağlıdır. Hızlı erişim için Coucou AI katmanını diğer uygulamaların üzerinde gösterir."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 5: Accessibility Service -->
            <LinearLayout
                android:id="@+id/cardAccessibilityPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_avatar"
                        android:padding="8dp"
                        android:src="@drawable/ic_checklist_tasks"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Erişilebilirlik hizmeti"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusAccessibility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kontrol ediliyor…"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="İzin ver"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Onayladığın cihaz otomasyonları için gerekir; düğmelere dokunma, uygulama arama, metin yazma ve kaydırma işlemlerini destekler."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bottom Action Buttons -->
            <Button
                android:id="@+id/btnGrantAll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="TÜM İZİNLERİ VER"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_jarvis_pill_button"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="SİSTEM UYGULAMA AYARLARINI AÇ"
                android:textColor="?attr/themeAccent"
                android:textSize="13sp"
                android:textStyle="bold"
                app:strokeColor="?attr/themeAccent"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

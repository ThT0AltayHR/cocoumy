<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_jarvis_dock">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HELLOAI · KONTROL"
        android:textColor="#F4F6FF"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetControlTalk"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Konuş"
            android:textColor="#0C1420"
            android:textStyle="bold"
            android:background="#9FE7B8" />

        <TextView
            android:id="@+id/widgetControlChat"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sohbet"
            android:textColor="#F4F6FF"
            android:background="#293244" />

        <TextView
            android:id="@+id/widgetControlStandby"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Bekle"
            android:textColor="#F4F6FF"
            android:background="#293244" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayAvatarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            android:contentDescription="Geri"
            app:tint="?attr/themeTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yüzen avatarlar"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistan çalışırken gösterilecek avatarı seç"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="?attr/themeCardBg"
        app:strokeColor="?attr/themeCardBorder"
        app:strokeWidth="1dp"
        app:cardCornerRadius="18dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchOverlayEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Yüzen katmanı göster"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/themeCardBg"
        app:strokeColor="?attr/themeCardBorder"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDynamicIslandEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dinamik çentiği göster"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Konum, genişlik ve yükseklik aşağıdaki kaydırıcılardan ayarlanır."
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Genişlik" android:textColor="?attr/themeTextPrimary" android:layout_marginTop="8dp" />
            <SeekBar android:id="@+id/seekDynamicIslandWidth" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="220" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yükseklik" android:textColor="?attr/themeTextPrimary" />
            <SeekBar android:id="@+id/seekDynamicIslandHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="76" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Üst boşluk" android:textColor="?attr/themeTextPrimary" />
            <SeekBar android:id="@+id/seekDynamicIslandTop" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="120" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/themeCardBg"
        app:strokeColor="?attr/themeCardBorder"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avatar görünürlüğü"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/radioOverlayMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOverlayWorking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Çalışırken"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbOverlayAlways"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Her zaman açık"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avatarı ekran kenarına sabitle; sürükleyince en yakın kenara yerleşir."
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerOverlayEdge"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:entries="@array/overlay_edges"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp"
        android:text="AVATAR SEÇ"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="Seçmek için avatara dokun. Görev durumunu görmek için iki kez dokun."
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/avatarGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>
